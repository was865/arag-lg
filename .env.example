# ローカル開発用（`cp .env.example .env`）。compose と api の両方が読む。
# GPU 機の推論サービス。空なら readiness で skipped 扱い。
ARAG_TEI_EMBED_URL=
ARAG_TEI_RERANK_URL=
# docling-serve（PDF・Office の解析）。空ならテキスト系（txt/md/csv/json）だけ入庫できる
ARAG_DOCLING_URL=
# 文脈付与・図の説明のモデル（例 anthropic:claude-haiku-5-5）。空なら見出しパスで代用・図の説明なし
ARAG_CONTEXT_MODEL=
ARAG_VLM_MODEL=
# 上のモデルのキー（P5 の管理画面までは環境変数で渡す）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Valkey を使う場合
# REDIS_IMAGE=valkey/valkey:9.1.3
# REDIS_CLI=valkey-cli
# ホスト側ポート（旧版 a-rag と同時に動かすため既定をずらしている）
# API_PORT=8100
# WEB_PORT=3100
# POSTGRES_PORT=5433
# QDRANT_PORT=6343
# REDIS_PORT=6380
