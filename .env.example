# ローカル開発用（`cp .env.example .env`）。compose と api の両方が読む。
# ── 推論の部品（specs/016）─────────────────────────────────────────────
# 役割ごとに「自前（GPU 機・CPU コンテナ）」か「外部 API」かを選ぶ。代表的な組み合わせ:
#
#   [A] オフライン（データを外に出さない。GPU 機で compose.gpu.yaml を起動）
#       ARAG_TEI_EMBED_URL=http://<GPU機>:8081      ARAG_TEI_RERANK_URL=http://<GPU機>:8084
#       ARAG_DOCLING_URL=http://<GPU機>:5001
#       ARAG_CONTEXT_MODEL=openai:qwen3-8b          ARAG_CONTEXT_BASE_URL=http://<GPU機>:8090/v1
#       ARAG_VLM_MODEL=openai:qwen3-vl              ARAG_VLM_BASE_URL=http://<GPU機>:8091/v1
#       会話モデルは目録（ARAG_CHAT_MODELS か管理画面）に base_url 付きで登録する
#
#   [B] 軽量（GPU 機なし。推論は外部 API、解析だけ CPU の docling-serve: docker compose --profile parse up -d）
#       ARAG_DOCLING_URL=http://docling:5001
#       ARAG_EMBED_PROVIDER=openai  ARAG_EMBED_URL=https://api.openai.com/v1  ARAG_EMBED_MODEL=text-embedding-3-small
#       ARAG_RERANK_PROVIDER=cohere ARAG_RERANK_URL=https://api.cohere.com/v2 ARAG_RERANK_MODEL=rerank-v3.5
#       ARAG_CONTEXT_MODEL=deepseek:deepseek-flash  ARAG_VLM_MODEL=<画像を読めるモデル>
#       （Jina なら EMBED/RERANK とも https://api.jina.ai/v1、Voyage なら https://api.voyageai.com/v1）
#
#   [C] 混在（例: 埋め込み・rerank・解析は自前、図の説明と回答は API）
#
# 埋め込みのモデルや次元を変えるときは ARAG_QDRANT_COLLECTION を別の名前にして再索引する（次元が違うと入庫が止まる）。
# 鍵はログや readiness には出ない。外部 API は readiness で external と表示する（疎通確認で課金しない）。

# 自前の TEI。空なら readiness で skipped 扱い。
ARAG_TEI_EMBED_URL=
ARAG_TEI_RERANK_URL=
# 埋め込み: tei（既定）か openai（OpenAI 互換 /embeddings）。ARAG_EMBED_URL が空なら ARAG_TEI_EMBED_URL を使う
# ARAG_EMBED_PROVIDER=tei
# ARAG_EMBED_URL=
# ARAG_EMBED_API_KEY=
# ARAG_EMBED_MODEL=BAAI/bge-m3
# ARAG_EMBED_DIMENSIONS=0
# ARAG_QDRANT_COLLECTION=chunks
# 並べ替え: tei（既定）か cohere（Cohere 互換 /rerank）。ARAG_RERANK_URL が空なら ARAG_TEI_RERANK_URL を使う
# ARAG_RERANK_PROVIDER=tei
# ARAG_RERANK_URL=
# ARAG_RERANK_API_KEY=
# rerank のモデル名（記録用、TEI が載せているものに合わせる）と入力の文字数上限（0 は上限なし）
# ARAG_RERANK_MODEL=cl-nagoya/ruri-v3-reranker-310m
# ARAG_RERANK_MAX_CHARS=0
# docling-serve（PDF・Office の解析）。空ならテキスト系（txt/md/csv/json）だけ入庫できる
ARAG_DOCLING_URL=
# OCR 言語（空ならサーバ既定の RapidOCR。指定するなら 1 言語のみ、例 iso:ja）
# ARAG_DOCLING_OCR_LANG=
# 文脈付与・図の説明のモデル（例 deepseek:deepseek-flash、anthropic:claude-haiku-5-5）。空なら見出しパスで代用・図の説明なし
ARAG_CONTEXT_MODEL=
ARAG_VLM_MODEL=
# 文脈付与を自前の OpenAI 互換サーバ（GPU 機の vLLM など）で行う場合。JSON は単引用符で囲む
# ARAG_CONTEXT_MODEL=openai:qwen3-8b
# ARAG_CONTEXT_BASE_URL=http://<GPU機>:8090/v1
# ARAG_CONTEXT_MODEL_KWARGS='{"temperature": 0.3, "max_tokens": 300, "extra_body": {"chat_template_kwargs": {"enable_thinking": false}}}'
# ARAG_CONTEXT_MAX_DOCUMENT_TOKENS=12000
# ARAG_CONTEXT_API_KEY=
# 図の説明を自前の OpenAI 互換サーバ（GPU 機の vLLM・Qwen2.5-VL。compose.gpu.yaml の vlm profile）で行う場合
# ARAG_VLM_MODEL=openai:qwen3-vl
# ARAG_VLM_BASE_URL=http://<GPU機>:8091/v1
# ARAG_VLM_MODEL_KWARGS='{"temperature": 0, "max_tokens": 600}'
# 上のモデルのキー（P5 の管理画面までは環境変数で渡す）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# P3 エージェント: モデル目録（JSON、単引用符で囲む）。先頭の利用可能なもの（base_url があるか鍵がある）が既定
# ARAG_CHAT_MODELS='[{"id":"qwen3-8b","label":"Qwen3 8B","model":"openai:qwen3-8b","base_url":"http://<GPU機>:8090/v1","kwargs":{"temperature":0.3,"max_tokens":2048,"extra_body":{"chat_template_kwargs":{"enable_thinking":false}}},"tags":["local"]},{"id":"deepseek","label":"DeepSeek","model":"deepseek:deepseek-flash","tags":["cloud"]}]'
# 検索語の書き換え・会話の要約に使うモデル（目録の id。空なら会話モデルと同じ）
# ARAG_UTILITY_MODEL=qwen3-8b
# 管理画面で登録する LLM の API キーの暗号化鍵（Fernet）。カンマ区切りで複数置くと先頭で暗号化し全部で復号する（鍵の入れ替え）
# 作り方: cd api && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARAG_SECRET_KEY=
# Web と API が共有する合言葉。設定すると監査ログに利用者の IP が残る（未設定なら Web コンテナの IP）
# 作り方: openssl rand -hex 32
ARAG_FORWARD_SECRET=
# ARAG_RATE_LIMIT_RUNS_PER_MIN=20
# ARAG_MONTHLY_TOKEN_LIMIT=0
# Valkey を使う場合
# REDIS_IMAGE=valkey/valkey:9.1.3
# REDIS_CLI=valkey-cli
# ホスト側ポート（旧版 a-rag と同時に動かすため既定をずらしている）
# API_PORT=8100
# WEB_PORT=3100
# POSTGRES_PORT=5433
# QDRANT_PORT=6343
# REDIS_PORT=6380

# --- 認証（specs/006-auth）---
# セッションの署名と鍵の暗号化に使う。32 文字以上のランダムな値（例: openssl rand -base64 48）
BETTER_AUTH_SECRET=
# ブラウザから見た Web の URL（JWT の iss にもなる）
# BETTER_AUTH_URL=http://localhost:3100
# 本番の SMTP（未設定なら compose の Mailpit）
# ARAG_SMTP_URL=smtp://user:pass@smtp.example.com:587
# ARAG_MAIL_FROM=ARag <no-reply@example.com>
# 評価（python -m arag.eval）・arag.cli ingest-dir は `make eval-api` の評価用 api（127.0.0.1:8101）を使う。
# ここで ARAG_AUTH_MODE=dev にすると本番の api も開発用ヘッダを受け付けてしまうので変えない

# ブラウザでの確認用のローカルのテスト利用者（値は各自で生成して .env に入れる。本番では使わない）
ARAG_TEST_USER_EMAIL=owner@arag.test
ARAG_TEST_USER_PASSWORD=
ARAG_TEST_MEMBER_EMAIL=member1@arag.test
ARAG_TEST_MEMBER_PASSWORD=
